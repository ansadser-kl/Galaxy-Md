# Copy this file to .env and enter your WhatsApp number with country code.
# Digits only; example for India: 919876543210
BOT_NUMBER="919876543210"
# Optional: owner contact shown by .owner (defaults to BOT_NUMBER)
OWNER_NUMBER="919876543210"
# SUDO numbers allowed to control the bot in private mode; comma-separated, digits only.
SUDO="919111111111,919222222222"
# Initial mode: public or private (runtime changes with .mode are saved in mode.json).
MODE="public"
