# Copy to .env. Keep real secrets out of GitHub.
BOT_NUMBER="919876543210"
OWNER_NUMBER="919876543210"
SUDO="919111111111,919222222222"
MODE="public"

# Folder for the WhatsApp login. Clone sessions (session2, session3 ...) and the
# YouTube login (yt-auth.json) are stored next to it.
# Docker/Railway: mount a persistent volume at /data and keep this value.
# Termux/VPS: leave it unset to use ./session
SESSION_DIR="/data/session"

# --- Clone bots (.pair) ---
# How many extra numbers can be linked at once (0 turns .pair off, max 8)
MAX_CLONES=4
# true = only owner/SUDO can use ".pair <number>"
PAIR_OWNER_ONLY=false
# Seconds a pairing code stays valid before the half-made session is deleted
PAIR_WAIT_SECONDS=180

# --- YouTube downloads ---
# Longest video in minutes, biggest download in MB, downloads running at once
MAX_YT_DURATION=60
MAX_YT_SIZE=500
YT_CONCURRENCY=2
# Optional: a folder for temporary files (default: system temp folder)
# TEMP_DIR="./temp"

# --- Optional tool paths (only if the tool is not on PATH) ---
# FFMPEG_PATH="/usr/bin/ffmpeg"
# ANIM_DUMP_PATH="/usr/bin/anim_dump"

# --- Optional ---
# WA_BROWSER=safari   # safari (default), chrome, or android (needed for view-once media)
# UPLOAD_MAX_MB=200
